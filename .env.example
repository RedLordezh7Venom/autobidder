# ── Database ──────────────────────────────────────────────────
POSTGRES_PASSWORD=S3cur3P@ssw0rd!

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=R3d!sP@ss

# ── AI APIs ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# ── Worker ────────────────────────────────────────────────────
WORKER_SECRET=GenerateAStrongSecretHere

# ── n8n ───────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=32charEncryptionKeyHerePlease000
